# Copy this file to .env and fill in the values below.
# Never commit .env: it contains secrets.

# Your user ID on the host, so files created by Airflow belong to you.
# Get it with: id -u
AIRFLOW_UID=501

# Encryption key for secrets stored by Airflow. Generate one with:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=replace-with-a-generated-key

# Secret shared by the Airflow services to sign their tokens. Generate one with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-generated-secret